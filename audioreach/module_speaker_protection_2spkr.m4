include(`util/util.m4') dnl
dnl AR_MODULE_SP_2SPKR(index, sgidx, container-idx, iid, maxip-ports, max-op-ports, in-ports, out-ports, src-port, dst-port, dst-iid)
dnl
dnl glymur-crd (WSA8845 / wsa884x) speaker protection static cfg blob,
dnl 2 speakers, generated from the 2 channel calibration dump
dnl (param_2_channels/sp_2_channels.txt) by
dnl sp_vi_data/ai_generated_blob/gen_sp_blob.py --module sp. That generator was
dnl validated by regenerating the 4 speaker blob this file previously carried,
dnl byte for byte, from sp_vi_data/SP_v5_Module.txt -- which in turn had been
dnl validated against the ACDB authored blob for the same dump. The 2 channel
dnl dump was then checked to have identical per-param shape, with only the
dnl per-speaker array counts differing (cmp_dump_shape.py, verify_2ch_blob.py).
dnl
dnl Two params present in the dump are deliberately NOT in the blob, the same
dnl pair excluded from the 4 speaker blob: PARAM_ID_SPV5_DYNAMIC_NOTCH
dnl (0x08001AEB) and PARAM_ID_SPV5_FIR_FILTERBANK_CFG (0x08001AEC). Neither id
dnl is defined anywhere in the ADSP source; both were only ever recovered by
dnl inference from an ACDB blob, so they are not sent. That is why this blob
dnl carries 17 records where the dump holds 19 params.
dnl
dnl The sp$1_cfg_data words are, in order:
dnl   words 0-3  struct audioreach_module_priv_data wrapper -- size of the
dnl              record stream (total - 16), then SND_SOC_AR_TPLG_MODULE_CFG_TYPE
dnl              (0x01001006), then two reserved words. Not a param record.
dnl   words 4+   17 apm_module_param_data records, ascending param_id. Each is
dnl              a 16 byte header (module_instance_id, param_id, param_size,
dnl              error_code) followed by param_size bytes of payload, zero
dnl              padded up to an 8 byte boundary -- except a param_size of 2,
dnl              which emits no payload word at all and lets the next record
dnl              start immediately. Note this differs from the VI blob in
dnl              module_speaker_protection_vi_4spkr.m4, which packs its
dnl              records with no padding whatsoever.
dnl
dnl PARAM_ID_SP_STATIC_CFG's num_speakers (payload word 3, offset 8) is 2 here
dnl and establishes the count every other channel scaled param's num_ch is
dnl checked against; a mismatch makes the DSP silently drop the set.
dnl
dnl Each record's module_instance_id is SP_IID_HEX, which expands to the iid
dnl passed in as $4 (0x6052 here, SP_MODULE_IID = MOD_IID_START + 2) formatted
dnl as eight hex digits. Substituting it here rather than baking in a literal
dnl keeps the blob correct if the topology's iid allocation moves, and means
dnl the kernel does not have to rewrite anything at graph open time. An
dnl earlier revision used a 0x00004026 placeholder patched by the kernel
dnl (AR_SP_CFG_DATA_STALE_IID); that scanning logic is gone, so a stale
dnl placeholder here would now reach the DSP verbatim and be dropped.
dnl
dnl To regenerate:
dnl   python3 gen_sp_blob.py --module sp ../../param_2_channels/sp_2_channels.txt \
dnl           -o sp_v5_glymur_2ch_blob
dnl then splice the words list in with splice_blob.py; the generated .m4
dnl already carries SP_IID_HEX rather than a literal iid.
define(`AR_MODULE_SP_2SPKR',
`'dnl
dnl The blob's records carry the instance id as a bare hex word, so format $4
dnl (a decimal iid from eval()) as eight hex digits.
`pushdef(`SP_IID_HEX', `'eval($4,16,8))'dnl
`'
`SectionVendorTuples."NAME_PREFIX.sp$1_tuples" {'
`        tokens "audioreach_tokens"'
`'
`        tuples."word.u32_data" {'
`                AR_TKN_U32_MODULE_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_ID STR(MODULE_ID_SPEAKER_PROTECTION)'
`                AR_TKN_U32_MODULE_MAX_IP_PORTS STR($5)'
`                AR_TKN_U32_MODULE_MAX_OP_PORTS STR($6)'
`                AR_TKN_U32_MODULE_IN_PORTS STR($7)'
`                AR_TKN_U32_MODULE_OUT_PORTS STR($8)'
`                AR_TKN_U32_MODULE_SRC_OP_PORT_ID STR($9)'
`                AR_TKN_U32_MODULE_DST_IN_PORT_ID STR($10)'
`                AR_TKN_U32_MODULE_SRC_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_DST_INSTANCE_ID STR($11)'
`        }'
`}'
`'
`SectionData."NAME_PREFIX.sp$1_data" {'
`        tuples "NAME_PREFIX.sp$1_tuples"'
`}'
`'
